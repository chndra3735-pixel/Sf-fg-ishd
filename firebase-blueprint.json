{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public social profile for a SwarRoom user (no PII stored; DP stored in Supabase Storage).",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the user." },
        "displayName": { "type": "string", "description": "Display name shown in rooms and chats." },
        "handle": { "type": "string", "description": "Short social handle." },
        "avatarUrl": { "type": "string", "description": "Supabase Storage or profile avatar URL." },
        "bio": { "type": "string", "description": "Short user bio." },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "clubTag": { "type": "string", "description": "Club badge tag such as UP55." },
        "coins": { "type": "integer", "description": "Virtual social coin balance." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update." }
      },
      "required": ["userId", "displayName", "handle", "avatarUrl", "bio", "gender", "clubTag", "coins", "createdAt", "updatedAt"]
    },
    "VoiceRoom": {
      "title": "VoiceRoom",
      "description": "Live voice chat room metadata; cover image stored in Supabase Storage.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "description": "Host Firebase Auth UID." },
        "ownerName": { "type": "string", "description": "Host display name." },
        "ownerAvatarUrl": { "type": "string", "description": "Host DP URL." },
        "title": { "type": "string", "description": "Voice room title." },
        "roomCode": { "type": "string", "description": "Display room ID code." },
        "category": { "type": "string", "description": "Room category label." },
        "coverUrl": { "type": "string", "description": "Supabase Storage cover / Room DP image URL." },
        "backgroundTheme": { "type": "string", "enum": ["stadium", "aurora", "neon", "sunset", "custom"] },
        "themeBackgroundUrl": { "type": "string", "description": "Custom room background theme photo/GIF URL visible to all room members." },
        "clubTag": { "type": "string", "description": "Room club badge." },
        "welcomeNotice": { "type": "string", "description": "Room welcome announcement." },
        "seatCount": { "type": "integer", "description": "Total voice seats (1 to 22)." },
        "managerUids": { "type": "array", "description": "Up to 5 manager Firebase UIDs appointed by host." },
        "isPinLocked": { "type": "boolean", "description": "Whether entering this room requires a PIN." },
        "roomPin": { "type": "string", "description": "Numeric room entry PIN set by host." },
        "listenerCount": { "type": "integer", "description": "Active listeners count." },
        "isLive": { "type": "boolean" },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "ownerName", "ownerAvatarUrl", "title", "roomCode", "category", "coverUrl", "backgroundTheme", "clubTag", "welcomeNotice", "seatCount", "listenerCount", "isLive", "isPublic", "createdAt", "updatedAt"]
    },
    "RoomSeat": {
      "title": "RoomSeat",
      "description": "Voice seat state inside a voice chat room.",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "roomOwnerId": { "type": "string" },
        "isRoomPublic": { "type": "boolean" },
        "seatIndex": { "type": "integer" },
        "occupantUid": { "type": "string" },
        "occupantName": { "type": "string" },
        "occupantAvatarUrl": { "type": "string" },
        "isLocked": { "type": "boolean" },
        "isMuted": { "type": "boolean" },
        "isSpeaking": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "roomOwnerId", "isRoomPublic", "seatIndex", "occupantUid", "occupantName", "occupantAvatarUrl", "isLocked", "isMuted", "isSpeaking", "updatedAt"]
    },
    "RoomMessage": {
      "title": "RoomMessage",
      "description": "Real-time text, join, or emoji message inside a voice room.",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "roomOwnerId": { "type": "string" },
        "isRoomPublic": { "type": "boolean" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatarUrl": { "type": "string" },
        "text": { "type": "string" },
        "messageType": { "type": "string", "enum": ["text", "join", "gift", "emoji"] },
        "badgeTag": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "roomOwnerId", "isRoomPublic", "senderUid", "senderName", "senderAvatarUrl", "text", "messageType", "badgeTag", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "1-on-1 real-time direct messaging thread.",
      "type": "object",
      "properties": {
        "participantUids": { "type": "array" },
        "participantNames": { "type": "object" },
        "participantAvatars": { "type": "object" },
        "lastMessage": { "type": "string" },
        "lastSenderUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participantUids", "participantNames", "participantAvatars", "lastMessage", "lastSenderUid", "createdAt", "updatedAt"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Real-time text message inside a 1-on-1 conversation.",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string" },
        "participantUids": { "type": "array" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["text", "image"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["conversationId", "participantUids", "senderUid", "senderName", "text", "createdAt"]
    },
    "MomentPost": {
      "title": "MomentPost",
      "description": "Community video or photo moment post whose media file is stored in Supabase Storage.",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatarUrl": { "type": "string" },
        "caption": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["video", "image"] },
        "isPublic": { "type": "boolean" },
        "likesCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorUid", "authorName", "authorAvatarUrl", "caption", "mediaUrl", "mediaType", "isPublic", "likesCount", "createdAt", "updatedAt"]
    },
    "EmojiCatalogItem": {
      "title": "EmojiCatalogItem",
      "description": "Custom emoji added by admin Gmail for all users across categories.",
      "type": "object",
      "properties": {
        "createdByUid": { "type": "string" },
        "label": { "type": "string" },
        "category": { "type": "string" },
        "symbol": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["createdByUid", "label", "category", "symbol", "imageUrl", "isActive", "createdAt"]
    },
    "GiftCatalogItem": {
      "title": "GiftCatalogItem",
      "description": "Virtual or video gift added by admin Gmail for all users; media stored in Supabase Storage.",
      "type": "object",
      "properties": {
        "createdByUid": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "emoji": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["emoji", "image", "video"] },
        "coinCost": { "type": "integer" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["createdByUid", "name", "category", "emoji", "thumbnailUrl", "mediaUrl", "mediaType", "coinCost", "isActive", "createdAt"]
    },
    "GiftEvent": {
      "title": "GiftEvent",
      "description": "Real-time gift broadcast driving full-screen room video playback and cross-room marquee banners.",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "roomTitle": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatarUrl": { "type": "string" },
        "recipientUid": { "type": "string" },
        "recipientName": { "type": "string" },
        "giftId": { "type": "string" },
        "giftName": { "type": "string" },
        "giftEmoji": { "type": "string" },
        "giftMediaUrl": { "type": "string" },
        "giftMediaType": { "type": "string", "enum": ["emoji", "image", "video"] },
        "coinCost": { "type": "integer" },
        "quantity": { "type": "integer" },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "roomTitle", "senderUid", "senderName", "senderAvatarUrl", "recipientUid", "recipientName", "giftId", "giftName", "giftEmoji", "giftMediaUrl", "giftMediaType", "coinCost", "quantity", "isPublic", "createdAt"]
    },
    "LevelTierConfig": {
      "title": "LevelTierConfig",
      "description": "Admin-configured entry video URL, animated DP frame URL, level-up coin reward, and profile badge URL per level tier.",
      "type": "object",
      "properties": {
        "badgeLevel": { "type": "integer" },
        "entryVideoUrl": { "type": "string" },
        "avatarFrameUrl": { "type": "string" },
        "rewardCoins": { "type": "integer" },
        "profileBadgeUrl": { "type": "string" },
        "updatedByUid": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["badgeLevel", "entryVideoUrl", "avatarFrameUrl", "rewardCoins", "profileBadgeUrl", "updatedByUid", "updatedAt"]
    },
    "LevelRewardClaim": {
      "title": "LevelRewardClaim",
      "description": "Immutable record tracking one-time level-up reward coins claimed by a user for a level tier.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "badgeLevel": { "type": "integer" },
        "coinsGranted": { "type": "integer" },
        "claimedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "badgeLevel", "coinsGranted", "claimedAt"]
    },
    "RoomPresenceMember": {
      "title": "RoomPresenceMember",
      "description": "Ephemeral live presence heartbeat record for a user currently inside a voice room.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "roomId": { "type": "string" },
        "roomOwnerId": { "type": "string" },
        "isRoomPublic": { "type": "boolean" },
        "displayName": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "clubTag": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "lastSeenAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "roomId", "roomOwnerId", "isRoomPublic", "displayName", "avatarUrl", "clubTag", "joinedAt", "lastSeenAt"]
    },
    "AppUpdateConfig": {
      "title": "AppUpdateConfig",
      "description": "Admin-managed GitHub repository link used by all SwarRoom clients to detect new GitHub Release APK updates.",
      "type": "object",
      "properties": {
        "githubRepoUrl": { "type": "string" },
        "updatedByUid": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["githubRepoUrl", "updatedByUid", "updatedAt"]
    },
    "UserAuditProfile": {
      "title": "UserAuditProfile",
      "description": "Private onboarding & audit metadata (Gmail, Google DP, 10-digit numeric ID, DOB, first-time location, room conduct acceptance, and admin block state).",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "numericId": { "type": "string" },
        "userEmail": { "type": "string" },
        "displayName": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "dobIso": { "type": "string" },
        "ageYears": { "type": "integer" },
        "locationLabel": { "type": "string" },
        "locationLat": { "type": "number" },
        "locationLng": { "type": "number" },
        "locationStatus": { "type": "string", "enum": ["pending", "captured", "denied", "unavailable"] },
        "termsAccepted": { "type": "boolean" },
        "onboardingCompleted": { "type": "boolean" },
        "isBlockedByAdmin": { "type": "boolean" },
        "firstLoginAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "numericId", "userEmail", "displayName", "avatarUrl", "dobIso", "ageYears", "locationLabel", "locationLat", "locationLng", "locationStatus", "termsAccepted", "onboardingCompleted", "isBlockedByAdmin", "firstLoginAt", "updatedAt"]
    },
    "UserActivityLog": {
      "title": "UserActivityLog",
      "description": "7-month retained audit log of user room visits/duration, room chats, inbox messages, and inbox DP photos (auto-expires after 7 months).",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "numericId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatarUrl": { "type": "string" },
        "activityType": { "type": "string", "enum": ["room_visit", "room_chat", "inbox_chat", "inbox_media"] },
        "roomId": { "type": "string" },
        "roomTitle": { "type": "string" },
        "roomCode": { "type": "string" },
        "conversationId": { "type": "string" },
        "targetUid": { "type": "string" },
        "targetNumericId": { "type": "string" },
        "targetName": { "type": "string" },
        "textContent": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "dateKey": { "type": "string" },
        "enteredAtMs": { "type": "integer" },
        "exitedAtMs": { "type": "integer" },
        "durationSeconds": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "numericId", "userEmail", "userName", "userAvatarUrl", "activityType", "roomId", "roomTitle", "roomCode", "conversationId", "targetUid", "targetNumericId", "targetName", "textContent", "mediaUrl", "dateKey", "enteredAtMs", "exitedAtMs", "durationSeconds", "createdAt", "expiresAt"]
    },
    "RoomKickLog": {
      "title": "RoomKickLog",
      "description": "Audit log of which host or manager kicked out which user inside a room with exact timestamp.",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "roomOwnerId": { "type": "string" },
        "isRoomPublic": { "type": "boolean" },
        "actorUid": { "type": "string" },
        "actorNumericId": { "type": "string" },
        "actorName": { "type": "string" },
        "actorAvatarUrl": { "type": "string" },
        "actorRole": { "type": "string", "enum": ["owner", "manager"] },
        "targetUid": { "type": "string" },
        "targetNumericId": { "type": "string" },
        "targetName": { "type": "string" },
        "targetAvatarUrl": { "type": "string" },
        "reason": { "type": "string" },
        "kickedAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "roomOwnerId", "isRoomPublic", "actorUid", "actorNumericId", "actorName", "actorAvatarUrl", "actorRole", "targetUid", "targetNumericId", "targetName", "targetAvatarUrl", "reason", "kickedAtMs", "createdAt"]
    },
    "NumericIdLookup": {
      "title": "NumericIdLookup",
      "description": "10-digit numeric ID lookup entry allowing room hosts to appoint managers by ID without enumerating user profiles.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "numericId": { "type": "string" },
        "displayName": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "numericId", "displayName", "avatarUrl", "updatedAt"]
    },
    "CpRelationship": {
      "title": "CpRelationship",
      "description": "Linked CP / Best-Friend pair connecting two user IDs with acceptance workflow, gift-driven CP level XP, and bond longevity aura.",
      "type": "object",
      "properties": {
        "memberUids": { "type": "array" },
        "memberNumericIds": { "type": "object" },
        "memberNames": { "type": "object" },
        "memberAvatars": { "type": "object" },
        "requesterUid": { "type": "string" },
        "recipientUid": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted"] },
        "cpXp": { "type": "integer" },
        "totalGiftsCount": { "type": "integer" },
        "bondTitle": { "type": "string" },
        "acceptedAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["memberUids", "memberNumericIds", "memberNames", "memberAvatars", "requesterUid", "recipientUid", "status", "cpXp", "totalGiftsCount", "bondTitle", "acceptedAtMs", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public social profiles for SwarRoom users."
    },
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/VoiceRoom" },
      "description": "Live voice chat rooms."
    },
    "/rooms/{roomId}/seats/{seatId}": {
      "schema": { "$ref": "#/entities/RoomSeat" },
      "description": "Voice seats in a live room."
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/RoomMessage" },
      "description": "Real-time text messages inside a voice room."
    },
    "/rooms/{roomId}/presence/{userId}": {
      "schema": { "$ref": "#/entities/RoomPresenceMember" },
      "description": "Live presence heartbeat documents for users currently active inside a voice room."
    },
    "/rooms/{roomId}/kick_logs/{logId}": {
      "schema": { "$ref": "#/entities/RoomKickLog" },
      "description": "Immutable room kick audit records showing actor (owner/manager), target user, and exact time."
    },
    "/numeric_id_lookup/{numericId}": {
      "schema": { "$ref": "#/entities/NumericIdLookup" },
      "description": "Direct get-by-ID mapping from 10-digit numeric ID to userId, displayName, and avatarUrl."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "1-on-1 real-time direct messaging conversations."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/DirectMessage" },
      "description": "Messages in a 1-on-1 direct conversation."
    },
    "/moments/{momentId}": {
      "schema": { "$ref": "#/entities/MomentPost" },
      "description": "Community video & DP moments stored in Supabase Storage."
    },
    "/emoji_catalog/{emojiId}": {
      "schema": { "$ref": "#/entities/EmojiCatalogItem" },
      "description": "Admin-managed custom emojis visible to all users."
    },
    "/gift_catalog/{giftId}": {
      "schema": { "$ref": "#/entities/GiftCatalogItem" },
      "description": "Admin-managed gifts and video gifts visible to all users."
    },
    "/gift_events/{eventId}": {
      "schema": { "$ref": "#/entities/GiftEvent" },
      "description": "Real-time gift send broadcasts for full-screen playback and cross-room marquee banner."
    },
    "/level_configs/{tierId}": {
      "schema": { "$ref": "#/entities/LevelTierConfig" },
      "description": "Admin-managed level tier rewards (entry video, avatar frame, coins, profile badge) synced in real time."
    },
    "/level_claims/{claimId}": {
      "schema": { "$ref": "#/entities/LevelRewardClaim" },
      "description": "User-scoped immutable claims of unlocked level tier reward coins."
    },
    "/app_config/{configId}": {
      "schema": { "$ref": "#/entities/AppUpdateConfig" },
      "description": "Global admin-managed app configuration such as the GitHub repository link for release updates."
    },
    "/user_audit_profiles/{userId}": {
      "schema": { "$ref": "#/entities/UserAuditProfile" },
      "description": "Private user onboarding, DOB, location, Gmail, and admin moderation state."
    },
    "/user_activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/UserActivityLog" },
      "description": "7-month retained room visit duration, room chat, and inbox chat/DP activity logs for Admin inspection."
    },
    "/cp_links/{pairId}": {
      "schema": { "$ref": "#/entities/CpRelationship" },
      "description": "Linked CP / Best-Friend pairs supporting ID lookup invites, agreement notifications, gift-based level XP, and paired seat animations."
    }
  }
}
