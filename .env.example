# GEMINI_API_KEY: Not used by SwarRoom.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Supabase Storage Configuration (Required for DP, room covers, and short video uploads).
# Configure these in the AI Studio Secrets panel.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_BUCKET=swarroom-media

# Agora Real-Time Voice SDK Configuration (Required for live multi-user voice audio in rooms).
# Configure AGORA_APP_ID in the AI Studio Secrets panel (use Agora Testing Mode App ID).
AGORA_APP_ID=YOUR_AGORA_APP_ID
